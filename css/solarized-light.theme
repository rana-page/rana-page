{
    "_comment": "Port of the Hakyll site's css/syntax.css (Solarized-light tinted pandoc classes) into a pandoc/Quarto highlight theme.",
    "text-color": null,
    "background-color": "#fdf6e3",
    "line-number-color": "#aaaaaa",
    "line-number-background-color": null,
    "text-styles": {
        "Alert":          { "text-color": "#cb4b16", "bold": true },
        "Annotation":     { "text-color": "#60a0b0", "bold": true, "italic": true },
        "Attribute":      { "text-color": "#7d9029" },
        "BaseN":          { "text-color": "#d33682" },
        "BuiltIn":        { },
        "ControlFlow":    { "text-color": "#5f8700", "bold": true },
        "Char":           { "text-color": "#dc322f" },
        "Constant":       { "text-color": "#880000" },
        "Comment":        { "text-color": "#93a1a1", "italic": true },
        "CommentVar":     { "text-color": "#60a0b0", "bold": true, "italic": true },
        "Documentation":  { "text-color": "#ba2121", "italic": true },
        "DataType":       { "text-color": "#268bd2" },
        "DecVal":         { "text-color": "#d33682" },
        "Error":          { "text-color": "#d30102", "bold": true },
        "Extension":      { },
        "Float":          { "text-color": "#d33682" },
        "Function":       { "text-color": "#268bd2" },
        "Import":         { "text-color": "#d70000" },
        "Information":    { "text-color": "#60a0b0", "bold": true, "italic": true },
        "Keyword":        { "text-color": "#268bd2", "bold": true },
        "Operator":       { "text-color": "#666666" },
        "Other":          { "text-color": "#a57800" },
        "Preprocessor":   { "text-color": "#bc7a00" },
        "SpecialChar":    { "text-color": "#4070a0" },
        "SpecialString":  { "text-color": "#bb6688" },
        "String":         { "text-color": "#2aa198" },
        "Variable":       { "text-color": "#19177c" },
        "VerbatimString": { "text-color": "#4070a0" },
        "Warning":        { "text-color": "#60a0b0", "bold": true, "italic": true },
        "Normal":         { }
    }
}
